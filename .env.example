# ============================================================
# AI Agent Architecture 실습용 .env.example
# ============================================================
# 사용 방법:
# 1. 이 파일을 복사해 .env 파일을 만듭니다.
# 2. 본인 환경에 맞게 API Key, DB 접속 정보, 모델명을 입력합니다.
# 3. 실제 .env 파일은 Git에 올리지 않습니다.
#
# 보안 주의:
# - 실제 API Key, 비밀번호, 사내 데이터, 개인정보, 민감정보를
#   GitHub, 화면 공유, 강의자료에 노출하지 마세요.
# - .env.example에는 실제 비밀값을 넣지 않습니다.
# ============================================================


# ------------------------------------------------------------
# 1. 전체 LLM 실행 방식 선택
# ------------------------------------------------------------
# 가능한 값:
# - mock  : API Key 없이 교육용 mock LLM을 사용합니다.
# - local : Ollama 기반 Local LLM을 사용합니다.
# - cloud : Gemini, OpenAI, Anthropic, NVIDIA 같은 Cloud LLM을 사용합니다.
#
# 첨부된 .env와 동일하게 cloud를 기본값으로 유지합니다.
# 단, 실제 Cloud API Key 값은 .env.example에 복사하지 않습니다.
LLM_PROVIDER=cloud


# ------------------------------------------------------------
# 2. Cloud LLM Provider 선택
# ------------------------------------------------------------
# 가능한 값 예시:
# - nvidia
# - gemini
# - openai
# - anthropic
CLOUD_LLM_PROVIDER=nvidia


# ------------------------------------------------------------
# 3. NVIDIA API Catalog / NIM 설정
# ------------------------------------------------------------
# Cloud LLM Provider를 nvidia로 사용할 때 설정합니다.
# 실제 API Key는 .env 파일에만 입력하고, .env.example에는 남기지 않습니다.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=stepfun-ai/step-3.5-flash

# NVIDIA 호출용 system prompt입니다.
# 실습 목적에 맞게 조정할 수 있습니다.
NVIDIA_SYSTEM_PROMPT=너는 제조 장애 대응 AI Agent다. 사용자가 요구한 출력 형식을 정확히 따르고, 제공된 근거 안에서만 판단한다. 근거 없는 원인 단정, 실제 사내 시스템 접근, 민감정보 노출은 하지 않는다. 응답은 한국어로 작성한다.


# ------------------------------------------------------------
# 4. 다른 Cloud Provider 설정 - 선택 사항
# ------------------------------------------------------------
# 실제 API Key는 .env 파일에만 입력합니다.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-haiku-latest


# ------------------------------------------------------------
# 5. Local LLM 설정 - 선택 사항
# ------------------------------------------------------------
# LLM_PROVIDER=local일 때 사용합니다.
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:1.5b
OLLAMA_RESPONSE_FORMAT=json


# ------------------------------------------------------------
# 6. 공통 LLM 생성 옵션
# ------------------------------------------------------------
# Tool Plan JSON 안정성을 우선할 때는 낮은 temperature를 권장합니다.
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.7
LLM_MAX_OUTPUT_TOKENS=4096


# ------------------------------------------------------------
# 7. 프로젝트 기본 설정
# ------------------------------------------------------------
PROJECT_NAME=manufacturing-agent-day5
APP_ENV=education
OUTPUT_DIR=outputs
LOG_LEVEL=INFO


# ------------------------------------------------------------
# 8. PostgreSQL 설정 - 교육용 Docker DB
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=manufacturing_agent_db
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change-me


# ------------------------------------------------------------
# 9. Day4 LLM Tool Selection 설정
# ------------------------------------------------------------
TOOL_SELECTOR_MODE=llm_based
DAY4_EXECUTE_LLM_TOOL_PLAN=false
DAY4_TOOL_SELECTION_FALLBACK=true
DAY4_TOOL_SELECTION_TEMPERATURE=0.0
DAY4_OUTPUT_DIR=outputs/day4
DAY4_TOOL_PLAN_VALIDATE_ONLY=true
DAY4_TOOL_SELECTION_MAX_CASES=100
DAY4_JSON_EXTRACTION_FALLBACK=true


# ------------------------------------------------------------
# 10. Cloud LLM 진단 로그 설정
# ------------------------------------------------------------
# 첨부된 .env와 동일한 설정값을 유지합니다.
# 단, 실제 API Key와 민감정보는 .env.example에 포함하지 않습니다.

# Cloud LLM 진단 로그 활성화
CLOUD_LLM_DIAGNOSTICS_ENABLED=true

# 진단 로그 저장 위치
CLOUD_LLM_DIAGNOSTICS_LOG_PATH=outputs/llm/cloud_llm_diagnostics.jsonl

# 진단 수준: basic / verbose
CLOUD_LLM_DIAGNOSTICS_LEVEL=verbose

# prompt/response 미리보기 최대 길이
CLOUD_LLM_DIAGNOSTICS_PREVIEW_CHARS=4096

# prompt 일부를 로그에 남길지 여부
CLOUD_LLM_DIAGNOSTICS_INCLUDE_PROMPT=true

# raw response 일부를 로그에 남길지 여부
CLOUD_LLM_DIAGNOSTICS_INCLUDE_RAW_RESPONSE=true

# choices를 몇 개까지 진단할지
CLOUD_LLM_DIAGNOSTICS_MAX_CHOICES=100
